  "content": {
    "用途": "后轴承座、支架、球铰、曲轴箱等灰铁结构件",
    "目标成分": {
      "碳 C": "3.45~3.60%",
      "硅 Si": "1.70~1.90%",
      "锰 Mn": "0.70~0.80%",
      "磷 P": "0.06~0.08%（端盖类 ≤0.04）",
      "硫 S": "0.06~0.09%",
      "锑 Sb": "0.022~0.030%（端盖 0.012~0.022）",
      "碳当量 CE": "4.06~4.30"
    },
    "炉料配比": "生铁 10% + 废钢 40% + 回炉料 50%；部分端盖类废钢 40~50%。炉料偏差±5%。",
    "增碳调碳": "碳化硅 25kg/炉，在第二次加增碳剂时加入。",
    "熔炼温度": "高温静置 1520±10℃ / 10min。",
    "出铁包量": "1000±20kg/包（部分产品 800±20kg/包）。",
    "孕育处理": "二次（浇注）孕育 0.5%（SiBa，加中转包内），随流孕育 2g/s（SiBa）。",
    "微量元素控制": "Cu≤0.05、Cr≤0.05、Sn≤0.01、Ti≤0.05、V≤0.05、Mo≤0.05、Al≤0.008、Ni≤0.01，其余之和≤0.1%。",
    "控制要点": [
      "炉前根据实际情况微调",
      "C 含量以碳硅仪为准，其余元素以光谱仪为准",
      "高温静置保证成分均匀"
    ]
  },
  "reference": {
    "book": "现场熔炼配料单（脱敏）",
    "chapter": "灰铁结构件类"
  },
