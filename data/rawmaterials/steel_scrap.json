      "压块": "尺寸≤400×400×500mm",
      "冲压料": "厚度≥0.6mm"
    },
    "外形要求": "块状，不允许有封闭管状；不锈钢、铝、电镀零件等异品不可混入；压块内部不得有泥沙、其他合金、受潮现象。",
    "表面状况": "洁净，不得有油污和严重锈蚀。",
    "化学成分": {
      "普通废钢": "C≤1.0%，Si≤0.45%，Mn≤0.9%，Cr≤0.1%，P≤0.08%，S≤0.1%，Ti≤0.06%，Al≤0.08%，Sn≤0.02%，Sb≤0.01%，B≤0.01%",
      "球铁废钢": "C≤0.8%，Cr≤0.08%，Zn≤0.05%，Sb≤0.01%，B≤0.005%（其余同普通废钢）",
      "高锰废钢": "Mn≤2.0%，Cr≤0.2%，Al≤0.1%，Ti≤0.08%，Sb≤0.02%（其余同普通废钢）"
    },
    "有害物控制": "放射性元素＜0.46μSv/h。",
    "验收要点": [
      "化学成分用光谱分析仪，6 样/批",
      "表面镀层检查：样品不打磨抛光，用酒精清洗擦干后分析",
      "判定规则：任一管理项目不符即不合格"
    ],
    "典型用途": "熔炼用废钢（控制合金废钢混入，避免带入 Cu/Cr/Ni 等微量元素）"
  },
