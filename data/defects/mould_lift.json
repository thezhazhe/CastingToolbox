    "causes": [
      "金属液浮力大于压铁重量/锁箱力",
      "压铁不足或放置不当（偏心、接触面小）",
      "型芯浮力大且未可靠固定",
      "浇注过快，静压头高"
    ],
    "prevention": [
      "校核浮力并加足压铁或采用锁箱",
      "压铁重心对准浇口与型腔中心，均匀压紧",
      "型芯用芯撑/芯头可靠固定",
      "控制浇注速度与静压头"
    ],
