  "content": {
    "symptoms": [
      "分型面、芯头等处出现多余薄片金属（飞翅/飞边）",
      "内孔、沟槽残留毛刺，清理后仍有飞边影响装配"
    ],
    "causes": [
      "分型面间隙过大、不严（砂箱变形/磨损）",
      "型砂紧实不足，合型力/压铁不足",
      "分型面有砂粒杂物，芯头间隙过大"
    ],
    "prevention": [
      "检查分型面平整度，及时修整砂箱；控制合型间隙",
      "合箱前清理分型面，提高型砂紧实度",
      "合理设置压铁/锁箱力；芯头间隙按工艺留足"
    ],
    "inspection": [
      "目视",
      "尺寸检查"
    ]
  },
