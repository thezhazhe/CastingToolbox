  "content": {
    "symptoms": [
      "铸钢件内部细小裂纹（发纹），断口呈银白色亮点（白点）",
      "多在厚大断面中心、淬火或机加工后暴露",
      "严重时铸件开裂报废"
    ],
    "causes": [
      "钢液中氢含量高且未充分脱除（精炼/脱氢不足）",
      "浇注温度高、冷却过快，氢来不及扩散逸出",
      "炉料潮湿、合金含氢、冶炼环境潮湿"
    ],
    "prevention": [
      "炉外精炼/真空脱气，降低钢液含氢量",
      "控制浇注温度与凝固冷却速度",
      "浇注前充分除渣除气，炉料与合金防潮",
      "大型件及时退火除氢"
    ],
    "inspection": [
      "超声探伤",
      "断口检查",
      "低倍组织"
    ]
  },
